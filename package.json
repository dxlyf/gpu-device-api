{
  "name": "@dxyl/gpu-device-api",
  "version": "0.4.0",
  "description": "Unified low-level WebGL2 / WebGPU abstraction library for easy drawing on either backend.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/gpu-device-api.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/gpu-device-api.umd.cjs",
  "jsdelivr": "./dist/gpu-device-api.umd.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/gpu-device-api.umd.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./webgl2": {
      "types": "./dist/webgl2.d.ts",
      "import": "./dist/webgl2.js"
    },
    "./webgpu": {
      "types": "./dist/webgpu.d.ts",
      "import": "./dist/webgpu.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxlyf/gpu-device-api.git"
  },
  "homepage": "https://github.com/dxlyf/gpu-device-api#readme",
  "bugs": {
    "url": "https://github.com/dxlyf/gpu-device-api/issues"
  },
  "keywords": [
    "webgl2",
    "webgpu",
    "graphics",
    "gpu",
    "renderer",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "lil-gui": "^0.20.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.60"
  }
}
